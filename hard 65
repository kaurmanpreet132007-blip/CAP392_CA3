class Solution {
    public boolean isNumber(String s) {

        boolean number = false;
        boolean decimal = false;
        boolean exponent = false;

        for (int i = 0; i < s.length(); i++) {

            char ch = s.charAt(i);

            if (ch >= '0' && ch <= '9') {
                number = true;
            }
            else if (ch == '.') {
                if (decimal || exponent)
                    return false;

                decimal = true;
            }
            else if (ch == 'e' || ch == 'E') {
                if (exponent || !number)
                    return false;

                exponent = true;
                number = false;
            }
            else if (ch == '+' || ch == '-') {
                if (i != 0 && s.charAt(i-1) != 'e' && s.charAt(i-1) != 'E')
                    return false;
            }
            else {
                return false;
            }
        }

        return number;
    }
}
